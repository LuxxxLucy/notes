#!/usr/bin/env -S uv run --quiet --script
# /// script
# dependencies = ["markdown"]
# ///
"""Serve one note as HTML with MathJax; the browser reloads when the note changes.

Usage: ./preview content/queuing_theory.md
Blocks until Ctrl-C.
"""
import http.server
import pathlib
import re
import subprocess
import sys

import markdown

ROOT = pathlib.Path(__file__).resolve().parent
SRC = pathlib.Path(sys.argv[1]).resolve()
CSS = (ROOT / "style.css").read_text()

PAGE = """<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>{css}</style>
<script>
  window.MathJax = {{ tex: {{ inlineMath: [['$', '$']], displayMath: [['$$', '$$']] }} }};
</script>
<script src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-chtml.js" async></script>
<script>
  const seen = "{mtime}";
  setInterval(async () => {{
    const now = await (await fetch("/mtime")).text();
    if (now !== seen) location.reload();
  }}, 500);
</script>
</head>
<body>
<main>
{body}
</main>
</body>
</html>
"""


def mtime():
    return str(SRC.stat().st_mtime_ns)


def render():
    src = re.sub(r"\A---\n.*?\n---\n", "", SRC.read_text(), flags=re.S)
    body = markdown.markdown(src, extensions=["tables", "fenced_code"])
    return PAGE.format(css=CSS, mtime=mtime(), body=body)


class Handler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == "/mtime":
            self.reply("text/plain", mtime())
        else:
            self.reply("text/html; charset=utf-8", render())

    def reply(self, ctype, text):
        data = text.encode()
        self.send_response(200)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)

    def log_message(self, *args):
        pass


server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Handler)
url = f"http://127.0.0.1:{server.server_address[1]}/"
print(f"serving {SRC.name} at {url}  (Ctrl-C to stop)", flush=True)
subprocess.run(["open", url], check=True)
try:
    server.serve_forever()
except KeyboardInterrupt:
    pass
